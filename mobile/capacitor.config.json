{
  "appId": "app.gatheringmarket",
  "appName": "Gather in One",
  "webDir": "www",
  "backgroundColor": "#140e09",
  "android": {
    "backgroundColor": "#140e09",
    "adjustMarginsForEdgeToEdge": "auto"
  },
  "plugins": {
    "LocalNotifications": {
      "iconColor": "#d6a84e",
      "smallIcon": "ic_stat_gm"
    },
    "BackgroundRunner": {
      "label": "app.gatheringmarket.prices",
      "src": "runners/background.js",
      "event": "checkPrices",
      "repeat": true,
      "interval": 30,
      "autoStart": true
    }
  }
}
